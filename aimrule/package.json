{
  "name": "@aimrule/dsh-plugin-flow",
  "version": "1.1.1",
  "type": "module",
  "description": "AimRule — human-in-the-loop business rule elaboration workbench with a nested rule canvas.",
  "license": "AGPL-3.0-or-later",
  "author": "AimRule contributors",
  "homepage": "https://github.com/shawnkuku/aimrule-agent/tree/main/aimrule#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawnkuku/aimrule-agent.git",
    "directory": "aimrule"
  },
  "bugs": {
    "url": "https://github.com/shawnkuku/aimrule-agent/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "business-rules",
    "flowchart",
    "rule-engine",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "shared/*.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
